{
  "name": "banner-preview",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/banner-preview",
  "projectType": "application",
  "tags": [],
  "targets": {
    "serve": {
      "options": {
        "port": 4300
      }
    },
    "test": {
      "outputs": ["{workspaceRoot}/coverage/apps/banner-preview"]
    },
    "typecheck": {
