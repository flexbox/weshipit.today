{
  "name": "davidl-fr",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/davidl-fr",
  "projectType": "application",
  "tags": [],
  "targets": {
    "postbuild": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "next-sitemap --config apps/davidl-fr/next-sitemap.config.js"
          }
        ]
      }
    },
    "serve": {
      "options": {
        "port": 4400
      }
    },
    "test": {
      "outputs": ["{workspaceRoot}/coverage/apps/davidl-fr"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p {projectRoot}/tsconfig.json"
      }
    },
    "supabase": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "supabase",
        "cwd": "{projectRoot}"
      }
    },
    "db-pull": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "supabase db pull",
        "cwd": "{projectRoot}"
      }
    },
    "db-push": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "supabase db push",
        "cwd": "{projectRoot}"
      }
    },
    "db-types": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "supabase gen types typescript --linked > src/types/supabase.ts",
        "cwd": "{projectRoot}"
      }
    }
  }
}
