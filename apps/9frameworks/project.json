{
  "name": "9frameworks",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/9frameworks",
  "projectType": "application",
  "tags": [],
  "targets": {
    "serve": {
      "options": {
        "port": 4500
      }
    },
    "icons": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/9frameworks/scripts/generate-icons.mjs"
      }
    },
    "test": {
      "outputs": ["{workspaceRoot}/coverage/apps/9frameworks"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p {projectRoot}/tsconfig.json"
      }
    }
  }
}
