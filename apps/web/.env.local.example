# HQ — lead magnets at /r/[slug] and the private dashboard at /hq.
# See docs/hq/plan.md. Copy the values into apps/web/.env.local and Vercel.

# Supabase project "weshipit-hq": Project Settings → API Keys. HQ_ prefix, not
# NEXT_PUBLIC_SUPABASE_*: the Supabase integration syncs those names from the
# davidl-fr project into this Vercel project. HQ only reads them on the server.
HQ_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
HQ_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
HQ_SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# The only address allowed into /hq; also receives a notification per lead.
HQ_OWNER_EMAIL=

# Absolute origin used in email links. Leave empty locally to use the request host.
HQ_SITE_URL=https://weshipit.today

# Shipmail: Developer → API keys (scope messages:send, "Hold email to outside
# addresses for review" off). Without it, emails are printed in the dev console.
SHIPMAIL_API_KEY=
# Bare address of the transactional sender, e.g. david@mail.weshipit.today
HQ_FROM_EMAIL=
