# Pull the real values with `cd apps/web && vercel env pull`.

# --- Audio testimonials -------------------------------------------------
# Signs the invite links behind /testimonial/<token>. Any long random string.
TESTIMONIAL_INVITE_SECRET=
# Password for /testimonials/moderation.
ADMIN_SECRET=
# Transcription (openai/gpt-4o-transcribe) + rewrite (anthropic/claude-sonnet-5),
# both through Vercel AI Gateway — one key for both.
AI_GATEWAY_API_KEY=
# Optional. Slack/Discord incoming webhook pinged on each new submission.
TESTIMONIAL_NOTIFY_WEBHOOK_URL=

# --- Vercel Blob (private store) ----------------------------------------
# Injected automatically once the store is connected to the project.
# BLOB_STORE_ID=
# VERCEL_OIDC_TOKEN=
# BLOB_READ_WRITE_TOKEN=
