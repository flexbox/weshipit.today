{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "dependsOn": ["^build", "sitemap"]
    },
    "sitemap": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON apps/web/scripts/generate-sitemap.mts"
      }
    },
    "test": {
      "outputs": ["{workspaceRoot}/coverage/apps/web"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p {projectRoot}/tsconfig.json"
      }
    },
    "serve": {
      "options": {
        "port": 4200
      }
    },
    "supabase": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "supabase",
        "cwd": "{projectRoot}"
      }
    },
    "db-push": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "supabase db push --linked",
        "cwd": "{projectRoot}"
      }
    },
    "db-types": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "supabase gen types typescript --linked > utils/hq/database.types.ts && npx prettier --write utils/hq/database.types.ts",
        "cwd": "{projectRoot}"
      }
    }
  }
}
